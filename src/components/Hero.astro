---
import { withBase } from '../lib/paths';
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-carousel" aria-hidden="true">
    <img src={withBase('/dsc_0176-scaled.jpg')} alt="" width="1920" height="1280" loading="eager" fetchpriority="high" />
    <img src={withBase('/dsc_0150-scaled.jpg')} alt="" width="1920" height="1280" loading="eager" />
    <img src={withBase('/dsc_0195-scaled.jpg')} alt="" width="1920" height="1280" loading="lazy" />
    <img src={withBase('/dsc_0101-1-scaled.jpg')} alt="" width="1920" height="1280" loading="lazy" />
    <img src={withBase('/dsc_0110-scaled.jpg')} alt="" width="2560" height="1707" loading="lazy" />
    <img src={withBase('/dsc_0168-scaled.jpg')} alt="" width="2560" height="1707" loading="lazy" />
    <img src={withBase('/dsc_0166-scaled.jpg')} alt="" width="2560" height="1916" loading="lazy" />
    <img src={withBase('/dsc_0205-scaled.jpg')} alt="" width="2560" height="1707" loading="lazy" />
    <img src={withBase('/dsc_0221-scaled.jpg')} alt="" width="2560" height="1707" loading="lazy" />
  </div>
  <div class="container hero-inner">
    <p class="eyebrow">Haga Nygata · Sedan 1990</p>
    <h1 id="hero-title" class="visually-hidden">Fåfängans Antik</h1>
    <img class="hero-logo" src={withBase('/fa-logotyp-white.svg')} width="473" height="117" alt="" aria-hidden="true" />
    <p class="hero-lead">Antikviteter och vintagebijouterier<br /> på Haga Nygata 16.</p>
    <a class="text-link" href="#besok">Planera ditt besök</a>
  </div>
</section>
